{
  "name": "archioffice",
  "productName": "ArchiOffice Client",
  "private": true,
  "version": "0.0.0",
  "description": "Gestion de cabinet d'architecture : projets, propositions, factures et équipe.",
  "author": "ArchiOffice",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx --import ./instrument.ts server.ts",
    "start": "tsx --import ./instrument.ts server.ts",
    "build": "mkdir -p dist && vite build && cp proxy.json dist/",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:vite --external:@modelcontextprotocol/sdk",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agents": "tsx scripts/eval-agents.ts",
    "electron:build": "npm run build && npm run build:server && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^1.29.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
