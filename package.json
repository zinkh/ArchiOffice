    "@tremor/react": "^3.18.7",
    "@types/qrcode": "^1.5.6",
    "@zinkh/archioffice-agents": "*",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
