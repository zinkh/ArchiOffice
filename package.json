    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
