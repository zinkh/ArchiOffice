# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings for email sending
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GEORISQUES_TOKEN=

# Google OAuth2 - pour la synchronisation Google Contacts, Google Calendar
# ET Gmail (même Client ID/Secret, trois scopes distincts demandés
# séparément par chaque flux). Créer un Client ID sur
# https://console.cloud.google.com/ (Application Web) et ajouter les
# origines autorisées et les URI de redirection suivantes :
#   - APP_URL/auth/google/callback           (Google Contacts, popup PKCE)
#   - APP_URL/api/google-calendar/callback   (Google Calendar, redirection classique)
#   - APP_URL/api/gmail/callback             (Gmail, redirection classique)
VITE_GOOGLE_CLIENT_ID=
# Requis pour Google Calendar (access_type=offline) ; optionnel pour Google
# Contacts seul (PKCE ne l'exige pas, mais requis si activé côté Google).
GOOGLE_CLIENT_SECRET=
# Override optionnel si l'URI de callback Google Calendar doit différer de
# celle dérivée automatiquement de la requête (ex. derrière un proxy).
GOOGLE_CALENDAR_REDIRECT_URI=
# Connecteur Gmail (onglet "Correspondance") — même Client ID/Secret que
# ci-dessus, scope Gmail en lecture seule. Ajouter
# APP_URL/api/gmail/callback aux URI de redirection autorisées côté Google.
GMAIL_REDIRECT_URI=

# Microsoft OAuth2 (Outlook / Microsoft 365) — pour le connecteur Outlook de
# l'onglet "Correspondance". Contrairement à Gmail, aucune app Azure
# n'existe déjà dans ArchiOffice : en créer une sur
# https://portal.azure.com/ (Microsoft Entra ID → Inscriptions d'applications
# → Nouvelle inscription), type de compte "Comptes dans n'importe quel
# annuaire organisationnel et comptes Microsoft personnels", puis ajouter
# APP_URL/api/outlook/callback comme URI de redirection (type Web) et créer
# un secret client (Certificats & secrets).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Override optionnel si l'URI de callback Outlook doit différer de celle
# dérivée automatiquement de la requête (ex. derrière un proxy).
OUTLOOK_REDIRECT_URI=

# Chiffrement au repos des secrets stockés en base : mots de passe IMAP
# (email_connections) et jetons OAuth refresh_token des intégrations
# connectées (Gmail, Google Calendar, Outlook, Zoho) — server/secretsCrypto.ts.
# 32 octets en base64. Générer avec : openssl rand -base64 32
MAIL_ENCRYPTION_KEY=

# Supabase - frontend (clé publique, safe dans le bundle)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase - backend Express uniquement (ne jamais exposer côté client)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Super-admin dashboard (propriétaire SaaS uniquement)
# Backend-only check (server/routes/superAdmin.ts) — définir l'email du propriétaire pour activer la route /admin.
SUPER_ADMIN_EMAIL=owner@example.com

# Tarification tokens IA (en EUR par million de tokens)
# Prix facturé aux tenants (inclut la marge opérateur ~3x le coût Gemini)
AI_PRICE_INPUT_PER_M=0.40
AI_PRICE_OUTPUT_PER_M=1.65

# Sentry error reporting — create a project at https://sentry.io and use its DSN.
# Leave both unset to disable reporting entirely (default for local dev).
# SENTRY_DSN: backend (Express) errors — server.ts and the agents package.
# VITE_SENTRY_DSN: frontend (browser) errors — baked into the bundle at build time.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Zoho OAuth redirect URIs — optionnel.
# Par défaut le serveur les déduit des en-têtes de la requête
# (x-forwarded-proto / x-forwarded-host). Définissez-les pour épingler
# exactement les « Authorized Redirect URIs » enregistrées dans la console API
# Zoho : si l'URL envoyée à Zoho diffère ne serait-ce que d'un caractère de
# celle enregistrée, Zoho refuse la connexion avec « Invalid Redirect Uri ».
# Les deux intégrations utilisent des chemins DIFFÉRENTS : enregistrez les deux.
# ZOHO_REDIRECT_URI=https://exemple.fr/api/zoho/callback
# ZOHO_BOOKS_REDIRECT_URI=https://exemple.fr/api/zoho-books/callback
