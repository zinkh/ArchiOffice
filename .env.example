# ── Fournisseurs IA ─────────────────────────────────────────────────────────
# Les appels modèle passent tous par packages/archioffice-agents/src/server/llm.
# Renseignez la clé du ou des fournisseurs que vous voulez rendre disponibles ;
# un fournisseur sans clé est simplement refusé (503), il ne fait rien planter.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mistral — https://console.mistral.ai/ (fournisseur français, hébergement UE :
# l'argument à retenir face à un client public soumis au RGPD).
MISTRAL_API_KEY=

# Fournisseur et modèle par défaut de l'instance. Non renseignés, l'app tourne
# sur gemini / gemini-3-flash-preview, comme avant l'ajout des adaptateurs.
# Valeurs possibles pour AI_PROVIDER : gemini, anthropic, mistral.
# AI_MODEL doit figurer au catalogue de llm/pricing.ts : un modèle non tarifé
# est refusé plutôt que facturé à un tarif inventé.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3-flash-preview

# APP_URL: The public HTTPS URL where this instance is reachable. Plain
# process.env.APP_URL everywhere it's read (server.ts, server/routes/*.ts,
# packages/archioffice-agents/src/server/mcp/*) — nothing in the code is
# specific to any one host. Some platforms (Cloud Run via AI Studio) inject
# it automatically; on DigitalOcean (or any other platform/bare Docker run),
# set it yourself as a regular runtime env var to your final public domain.
# Used for self-referential links, OAuth callbacks (Zoho, Google Calendar,
# Gmail, the MCP/Gemini link) and lifecycle emails — a wrong value here
# breaks all of them the same way regardless of platform.
APP_URL="MY_APP_URL"

# SMTP settings for email sending
# Bot Telegram (server/telegramBot.ts, server/routes/telegram.ts) — parler à
# un agent ArchiOffice en conduisant, la messagerie étant une catégorie
# pleinement supportée par Android Auto (dictée vocale + lecture des réponses),
# contrairement au lien MCP/Gemini (payant, hors conduite) ou à App Actions
# Android (comportement non garanti en voiture).
# Créer le bot via @BotFather sur Telegram (commande /newbot) pour obtenir le
# jeton ci-dessous, puis enregistrer le webhook une fois déployé :
#   curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=<APP_URL>/api/telegram/webhook" -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
# Recommandé : vérifié sur chaque appel entrant contre l'en-tête
# X-Telegram-Bot-Api-Secret-Token, pour s'assurer qu'un tiers ne peut pas
# appeler le webhook en se faisant passer pour Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Optionnel — juste pour l'afficher dans /settings (Réglages → Bot Telegram)
# à l'architecte qui doit chercher ce bot dans Telegram.
TELEGRAM_BOT_USERNAME=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GEORISQUES_TOKEN=

# Google OAuth2 - pour la synchronisation Google Contacts, Google Calendar
# ET Gmail (même Client ID/Secret, trois scopes distincts demandés
# séparément par chaque flux). Créer un Client ID sur
# https://console.cloud.google.com/ (Application Web) et ajouter les
# origines autorisées et les URI de redirection suivantes :
#   - APP_URL/auth/google/callback           (Google Contacts, popup PKCE)
#   - APP_URL/api/google-calendar/callback   (Google Calendar, redirection classique)
#   - APP_URL/api/gmail/callback             (Gmail, redirection classique)
VITE_GOOGLE_CLIENT_ID=
# Requis pour Google Calendar (access_type=offline) ; optionnel pour Google
# Contacts seul (PKCE ne l'exige pas, mais requis si activé côté Google).
GOOGLE_CLIENT_SECRET=
# Override optionnel si l'URI de callback Google Calendar doit différer de
# celle dérivée automatiquement de la requête (ex. derrière un proxy).
GOOGLE_CALENDAR_REDIRECT_URI=
# Connecteur Gmail (onglet "Correspondance") — même Client ID/Secret que
# ci-dessus, scope Gmail en lecture seule. Ajouter
# APP_URL/api/gmail/callback aux URI de redirection autorisées côté Google.
GMAIL_REDIRECT_URI=
# Connecteur Google Drive (Réglages > Intégrations > Stockage) — même Client
# ID/Secret que ci-dessus. Scope demandé : drive.file, volontairement étroit
# (l'application ne voit que les fichiers qu'elle a elle-même créés), ce qui
# évite l'évaluation de sécurité CASA imposée par le scope `drive` complet.
# Ajouter APP_URL/api/external-storage/callback aux URI de redirection
# autorisées côté Google. Override optionnel :
GOOGLE_DRIVE_REDIRECT_URI=

# Dropbox (Réglages > Intégrations > Stockage) — créer une app sur
# https://www.dropbox.com/developers/apps, type "Scoped access", accès "Full
# Dropbox" ou "App folder" au choix du cabinet. Scopes à cocher :
# files.content.write, files.content.read, files.metadata.read,
# account_info.read. Ajouter APP_URL/api/external-storage/callback aux
# Redirect URIs. Laisser vide désactive simplement la carte Dropbox.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Override optionnel de l'URI de redirection.
DROPBOX_REDIRECT_URI=

# Microsoft OAuth2 (Outlook / Microsoft 365) — pour le connecteur Outlook de
# l'onglet "Correspondance". Contrairement à Gmail, aucune app Azure
# n'existe déjà dans ArchiOffice : en créer une sur
# https://portal.azure.com/ (Microsoft Entra ID → Inscriptions d'applications
# → Nouvelle inscription), type de compte "Comptes dans n'importe quel
# annuaire organisationnel et comptes Microsoft personnels", puis ajouter
# APP_URL/api/outlook/callback comme URI de redirection (type Web) et créer
# un secret client (Certificats & secrets).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Override optionnel si l'URI de callback Outlook doit différer de celle
# dérivée automatiquement de la requête (ex. derrière un proxy).
OUTLOOK_REDIRECT_URI=

# Chiffrement au repos des secrets stockés en base : mots de passe IMAP
# (email_connections) et jetons OAuth refresh_token des intégrations
# connectées (Gmail, Google Calendar, Outlook, Zoho) — server/secretsCrypto.ts.
# 32 octets en base64. Générer avec : openssl rand -base64 32
MAIL_ENCRYPTION_KEY=

# Supabase - frontend (clé publique, safe dans le bundle)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase - backend Express uniquement (ne jamais exposer côté client)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Super-admin dashboard (propriétaire SaaS uniquement)
# Backend-only check (server/routes/superAdmin.ts) — définir l'email du propriétaire pour activer la route /admin.
SUPER_ADMIN_EMAIL=owner@example.com

# Marge opérateur sur les appels IA. Le coût réel de chaque modèle est une
# donnée du catalogue (llm/pricing.ts) ; ce facteur est le seul levier
# commercial, et il s'applique à tous les modèles à la fois. La valeur par
# défaut, 1.3333, reproduit au centime près les anciens tarifs forfaitaires
# (0,67 EUR/M en entrée, 4,00 EUR/M en sortie) pour gemini-3-flash-preview.
# AI_PRICE_INPUT_PER_M et AI_PRICE_OUTPUT_PER_M, qui ne valaient que pour un
# modèle unique, ne sont plus lues.
# AI_PRICE_MARKUP=1.3333

# Sentry error reporting — create a project at https://sentry.io and use its DSN.
# Leave both unset to disable reporting entirely (default for local dev).
# SENTRY_DSN: backend (Express) errors — server.ts and the agents package.
# VITE_SENTRY_DSN: frontend (browser) errors — baked into the bundle at build time.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Zoho OAuth redirect URIs — optionnel.
# Par défaut le serveur les déduit des en-têtes de la requête
# (x-forwarded-proto / x-forwarded-host). Définissez-les pour épingler
# exactement les « Authorized Redirect URIs » enregistrées dans la console API
# Zoho : si l'URL envoyée à Zoho diffère ne serait-ce que d'un caractère de
# celle enregistrée, Zoho refuse la connexion avec « Invalid Redirect Uri ».
# Les deux intégrations utilisent des chemins DIFFÉRENTS : enregistrez les deux.
# ZOHO_REDIRECT_URI=https://exemple.fr/api/zoho/callback
# ZOHO_BOOKS_REDIRECT_URI=https://exemple.fr/api/zoho-books/callback

# ── Agents IA : OCR, alertes et exécutions planifiées ───────────────────────
# OCR des documents joints sans couche texte (PDF scannés, photos de plans).
# Actif par défaut ; mettre false pour le désactiver complètement.
# La reconnaissance passe par tesseract.js (WebAssembly, aucune dépendance
# native) ; la mise en image des pages d'un PDF passe par pdftoppm
# (paquet poppler-utils, installé par le Dockerfile). Sans pdftoppm, seules
# les images sont reconnues et l'agent signale explicitement qu'il n'a pas pu
# lire le PDF scanné.
# AGENT_OCR_ENABLED=true
# AGENT_OCR_MAX_PAGES=5
# AGENT_OCR_LANG=fra+eng
# Chemins locaux des fichiers de langue, pour une instance sans accès sortant
# (sinon tesseract.js les télécharge à la première utilisation).
# AGENT_OCR_LANG_PATH=
# AGENT_OCR_CACHE_PATH=

# Fréquence du moteur d'alertes métier (server/agentAlerts.ts), en heures.
# AGENT_ALERTS_INTERVAL_HOURS=6
# Fréquence de vérification des tâches planifiées, en minutes.
# AGENT_SCHEDULER_TICK_MINUTES=15

# ── Notifications poussées (PWA) ────────────────────────────────────────────
# Clés VAPID du Web Push (server/push.ts). Sans elles, les notifications
# système se taisent : rien ne casse, la file notification_outbox continue
# d'alimenter le client de bureau et le flux d'activité en application.
# Générer une paire, une fois par instance :
#   node scripts/generate-vapid-keys.mjs
# Attention : changer la paire invalide tous les abonnements enregistrés.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact que le service de push (FCM, Mozilla, WNS) utilise en cas
# d'abus. mailto: ou https://. À défaut, APP_URL est utilisée.
VAPID_SUBJECT=mailto:contact@aazs.fr
